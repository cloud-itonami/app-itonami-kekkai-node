(ns kekkai.node.udp-underlay-test
  (:require [kotoba.test :refer [deftest is async]]
            [kekkai.node.udp :as udp]))

(defn- fake-bind-socket [type]
  (let [sock #js {}
        handlers (atom {})]
    (aset sock "type" type)
    (aset sock "on" (fn [event callback]
                       (swap! handlers assoc event callback)
                       sock))
    (aset sock "removeAllListeners" (fn [] (reset! handlers {}) sock))
    (aset sock "close" (fn [] nil))
    (aset sock "bind"
          (fn [_port _host callback]
            (if (= type "udp6")
              (let [error (js/Error. "IPv6 unavailable")]
                (set! (.-code error) "EAFNOSUPPORT")
                (js/setTimeout #((get @handlers "error") error) 0))
              (js/setTimeout callback 0))))
    sock))

(deftest socket-falls-back-to-udp4-if-dual-stack-bind-is-unavailable
  (async done
    (let [created (atom [])
          errors (atom [])
          socket-api #js {:createSocket
                          (fn [options]
                            (let [type (.-type options)]
                              (swap! created conj type)
                              (fake-bind-socket type)))}]
      (-> (udp/socket {:socket-api socket-api
                       :on-error #(swap! errors conj %)
                       :port 0})
          (.then (fn [sock]
                   (is (= ["udp6" "udp4"] @created))
                   (is (= "udp4" (.-type sock)))
                   (is (empty? @errors)
                       "the handled IPv6 bind failure is not surfaced")
                   (done)))
          (.catch (fn [error]
                    (is false (str "IPv4 fallback failed: " error))
                    (done)))))))

(deftest outgoing-datagrams-wait-for-acknowledged-underlay-routes
  (let [sent (atom [])
        socket #js {:send (fn [_bytes port host]
                            (swap! sent conj {:port port :host host}))}]
    (udp/guard-underlay! socket)
    (udp/send! socket [1 2 3] "relay.example:3478")
    (is (empty? @sent) "no UDP send before the extension route ACK")

    (udp/allow-underlay-hosts!
     socket ["relay.example"] {"relay.example" ["198.51.100.7"]})
    (is (= [{:port 3478 :host "::ffff:198.51.100.7"}] @sent)
        "the ACK releases the queued frame to its resolved numeric address")

    (udp/send! socket [4 5 6] "203.0.113.8:41641")
    (is (= 1 (count @sent)) "a newly discovered candidate is held")
    (udp/allow-underlay-hosts!
     socket ["relay.example" "203.0.113.8"]
     {"relay.example" ["198.51.100.7"]
      "203.0.113.8" ["203.0.113.8"]})
    (is (= [{:port 3478 :host "::ffff:198.51.100.7"}
            {:port 41641 :host "::ffff:203.0.113.8"}]
           @sent)
        "a candidate sends only after its updated route set is acknowledged")
    (udp/clear-underlay-guard! socket)))

(deftest family-specific-stun-sends-wait-for-route-ack-and-use-acked-family-addresses
  (let [sent (atom [])
        socket #js {:send (fn [_bytes port host]
                            (swap! sent conj {:port port :host host}))}]
    (udp/guard-underlay! socket)
    (udp/send-family! socket [9 8 7] "stun.example:3478" 6)
    (is (empty? @sent) "family-specific STUN probes wait for the route ACK")

    (udp/allow-underlay-hosts!
     socket ["stun.example"]
     {"stun.example" ["198.51.100.7" "2001:db8::7"]})
    (is (= [{:port 3478 :host "2001:db8::7"}] @sent)
        "the queued IPv6 probe is released only to the acknowledged IPv6 route")
    (udp/clear-underlay-guard! socket)))

(deftest family-specific-send-rechecks-guard-after-dns-resolution
  (async done
    (let [sent (atom [])
          socket #js {:send (fn [_bytes port host callback]
                              (swap! sent conj {:port port :host host})
                              (when callback (callback nil)))}]
      ;; The async DNS lookup starts without a guard. Install it before the
      ;; lookup callback returns, which is the race the packet tunnel can hit.
      (udp/send-family! socket [3 2 1] "localhost:3478" 6)
      (udp/guard-underlay! socket)
      (js/setTimeout
       (fn []
         (is (empty? @sent) "DNS completion remains queued until route ACK")
         (udp/allow-underlay-hosts!
          socket ["localhost"] {"localhost" ["::1"]})
         (js/setTimeout
          (fn []
            (udp/clear-underlay-guard! socket)
            (is (= [{:port 3478 :host "::1"}] @sent)
                "the packet is sent only to the acknowledged IPv6 address")
            (done))
          20))
       20))))

(deftest dual-stack-socket-roundtrips-ipv4-and-ipv6-loopback
  (async done
    (let [sock-ref (atom nil)
          received (atom [])
          timer (atom nil)]
      (-> (udp/socket
           {:on-message (fn [bytes from]
                          (swap! received conj {:bytes bytes :from from})
                          (when (= 2 (count @received))
                            (let [port (udp/local-port @sock-ref)]
                              (js/clearTimeout @timer)
                              (udp/close! @sock-ref)
                              (is (= #{{:bytes [4] :from (str "127.0.0.1:" port)}
                                       {:bytes [6] :from (str "[::1]:" port)}}
                                     (set @received)))
                              (done))))})
          (.then (fn [sock]
                   (reset! sock-ref sock)
                   (reset! timer (js/setTimeout
                                  (fn []
                                    (udp/close! sock)
                                    (is false (str "timed out; received " @received))
                                    (done))
                                  2000))
                   (udp/send! sock [4] (str "127.0.0.1:" (udp/local-port sock)))
                   (udp/send! sock [6] (str "[::1]:" (udp/local-port sock))))
                 (fn [error]
                   (is false (str "dual-stack bind failed: " error))
                   (done)))))))

(deftest dual-stack-socket-resolves-hostnames-before-send
  (async done
    (let [sock-ref (atom nil)
          acknowledged? (atom false)
          timer (atom nil)
          ack-timer (atom nil)]
      (-> (udp/socket
           {:on-message (fn [bytes from]
                          (when (= [8] bytes)
                            (let [port (udp/local-port @sock-ref)]
                              (js/clearTimeout @timer)
                              (js/clearTimeout @ack-timer)
                              (udp/close! @sock-ref)
                              (is @acknowledged?
                                  "a DNS lookup started before prepare waited for route ACK")
                              (is (= (str "[::1]:" port) from)
                                  "the ACK's resolved address selected the actual underlay target")
                              (done))))})
          (.then (fn [sock]
                   (reset! sock-ref sock)
                   (reset! timer (js/setTimeout
                                  (fn []
                                    (udp/close! sock)
                                    (is false "hostname UDP send timed out")
                                    (done))
                                  2000))
                   (udp/guard-underlay! sock)
                   (udp/send! sock [8] (str "localhost:" (udp/local-port sock)))
                   (reset! ack-timer
                           (js/setTimeout
                            (fn []
                              (reset! acknowledged? true)
                              (udp/allow-underlay-hosts!
                               sock ["localhost"] {"localhost" ["::1"]}))
                            100)))
                 (fn [error]
                   (is false (str "dual-stack bind failed: " error))
                   (done)))))))
