(ns kekkai.node.agent
  "The resident node agent — the component `kekkai`'s charter deliberately leaves
  to the node: it pulls the netmap the control plane published, establishes
  authenticated sessions to the peers that netmap authorizes, punches or relays
  its way to each of them, and serves MagicDNS for the result.

  It actuates the data plane; it never decides policy. Admission, edges and
  routes are the control plane's; if the netmap does not grant it, this agent
  does not do it, and it has no override.

  Everything that decides anything is in the pure namespaces (`netmap`, `peer`,
  `disco`, `relay`, `magicdns`). This file is the loop: one UDP socket, one relay
  client, N peers, a timer, and a DNS listener."
  (:require [kotoba.lang.text :as str]
            [kekkai.node.dns-server :as dns-server]
            [kekkai.node.endpoint :as ep]
            [kekkai.node.heartbeat :as node-heartbeat]
            [kekkai.node.netmap :as netmap]
            [kekkai.node.netmap-watch :as netmap-watch]
            [kekkai.node.peer :as peer]
            [kekkai.node.relay :as relay]
            [kekkai.node.signed-netmap :as signed-netmap]
            [kekkai.node.stun :as stun]
            [kekkai.node.udp :as udp]
            [kotoba.bytes :as b]
            [noise.core :as noise]
            [noise.provider.node :as provider]
            ["node:fs" :as fs]))

(defn now-ms [] (.getTime (js/Date.)))
(defn now-s [] (js/Math.floor (/ (now-ms) 1000)))

(def ^:private routine-events #{:data :packet :ping :pong})
(def ^:private routine-drop-reasons #{:auth-failed :no-matching-peer})

(defn log-event
  "Print lifecycle/error metadata, omitting high-volume packets and payloads.
  Callers that need detailed diagnostics can supply their own `:on-event`."
  [event]
  (when-not (or (contains? routine-events (:event event))
                (and (= :dropped (:event event))
                     (contains? routine-drop-reasons (:reason event))))
    (let [payload (:payload event)
          summary (cond-> (dissoc event :payload)
                    (some? payload) (assoc :payload-size (count payload)))]
      (println (str "[agent] " (pr-str summary))))))

(defn netmap-from-text
  "Parse and authenticate a netmap. Production defaults to a signed envelope.
   Raw EDN is available only through the explicit test/development opt-in."
  [text {:keys [netmap-authority-spki-b64 allow-unsigned-netmap?]}]
  (if allow-unsigned-netmap?
    (cljs.reader/read-string text)
    (signed-netmap/verify-envelope text netmap-authority-spki-b64)))

(defn load-netmap
  "Read and authenticate a netmap from a file."
  [path config]
  (netmap-from-text (.readFileSync fs path "utf8") config))

(defn- static-keypair [{:keys [priv pub]}]
  {:priv (b/unhex priv) :pub (b/unhex pub)})

;; ── state ───────────────────────────────────────────────────────────────────

(defn state
  [{:keys [config nm]}]
  (let [suite (noise/suite (provider/ports))
        static (static-keypair (:static config))
        self-id (or (:node/id (:netmap/self nm)) (:node/id config))]
    {:suite suite
     :static static
     :self-id self-id
     :config config
     :netmap nm
     :netmap-source-text (:netmap-source-text config)
     :netmap-rejected-source nil
     :netmap-read-error nil
     :prologue (b/utf8-encode (netmap/prologue-string nm))
     :peers {}            ; peer-id -> peer state
     :by-key {}           ; key-hex -> peer-id
     :relay nil           ; relay client state
     :relay-pool (netmap/relays nm) ; signed priority order for failover
     :relay-index 0
     :stopping? false
     :local-candidates []
     :heartbeat {:enabled? (boolean (:heartbeat config))
                 :sequence 0
                 :last-accepted-at nil
                 :last-error nil}
     :netmap-watch {:enabled? (boolean (:netmap-watch config))
                    :status (if (:netmap-watch config) :starting :disabled)
                    :last-installed-version (:netmap/version nm)
                    :last-error nil}
     :nat {:status (if (seq (:stun-servers config)) :pending :disabled)
           :servers-answered 0
           :candidates []
           :symmetric? nil}
     :sock nil}))

(defn- peer-for-key [st key-hex] (get (:peers st) (get (:by-key st) key-hex)))

(defn sync-peers
  "Reconcile the peer table against the netmap: add peers the netmap authorizes
   for the overlay capability, drop peers it no longer does. Dropping is the
   important half — a revoked peer must lose its session, not merely stop being
   dialled."
  [st now-ms*]
  (let [nm (:netmap st)
        sessionable (netmap/sessionable nm (quot now-ms* 1000))
        wanted (into {} (map (fn [{:keys [peer]}] [(:node/id peer) peer]))
                     sessionable)
        relay-region (or (some-> (:relay st) :region)
                         (some-> (first (netmap/relays nm)) :relay/region))
        peers (into {}
                    (for [[pid p] wanted]
                      [pid (or (get (:peers st) pid)
                               (peer/peer {:suite (:suite st)
                                           :static (:static st)
                                           :peer-key (b/unhex (netmap/peer-key p))
                                           :peer-id pid
                                           :prologue (:prologue st)
                                           :relay-region relay-region
                                           :candidates (ep/exclude-candidate-hosts
                                                        (netmap/endpoints p)
                                                        (:candidate-excluded-hosts
                                                         (:config st)))
                                           :initiator? (peer/should-initiate?
                                                        (:self-id st) pid)
                                           :disco-config (:disco (:config st))
                                           :policy (:policy (:config st))
                                           :now now-ms*}))]))
        removed (remove (set (keys wanted)) (keys (:peers st)))]
    (-> st
        (assoc :peers peers)
        (assoc :by-key (into {} (map (fn [[pid p]] [(b/hex (:peer-key p)) pid])) peers))
        (assoc :denied (netmap/denials nm :overlay (quot now-ms* 1000)))
        (assoc :dropped-peers (vec removed)))))

;; ── datagram routing ────────────────────────────────────────────────────────

(defn- send-out!
  "One outgoing peer datagram, routed either straight to an endpoint or wrapped
   for the relay. This is the only place that knows the difference."
  [st {:keys [route endpoint bytes peer-key]}]
  (let [sock (:sock st)]
    (case route
      :direct (do (when endpoint (udp/send! sock bytes (ep/->str endpoint))) st)
      :relay (if (and (:relay st) (relay/connected? (:relay st)))
               (let [[rc dg] (relay/client-send (:relay st) peer-key bytes (now-ms))]
                 (udp/send! sock (:bytes dg) (:to dg))
                 (assoc st :relay rc))
               st)                    ; no relay yet; the tick will retry
      st)))

(defn- relay-client-for [st record]
  (relay/client {:suite (:suite st) :static (:static st)
                 :relay-key (b/unhex (:relay/key record))
                 :relay-addr (relay/relay-addr record)
                 :relay-name (:relay/name record)
                 :region (:relay/region record)
                 :prologue (:prologue st)
                 :config (:relay (:config st))}))

(defn reconfigure-netmap
  "Prepare an authenticated, newer netmap for this running node.

  A version change changes the Noise prologue. Recreate every peer session and
  the relay session together so an old policy session cannot outlive the
  publication that replaced it. The local node ID, tailnet, and X25519 key are
  immutable for a running process; key rotation requires a restart with the new
  private key. Returns the new state and the first relay datagram to send."
  [st nm now-ms*]
  (let [problems (netmap/validate nm)
        current (:netmap st)
        old-version (:netmap/version current)
        new-version (:netmap/version nm)
        self (:netmap/self nm)
        expected-key (b/hex (get-in st [:static :pub]))]
    (when (seq problems)
      (throw (ex-info "replacement netmap is not usable"
                      {:type :kekkai/invalid-replacement-netmap
                       :problems problems})))
    (when (= nm current)
      (throw (ex-info "replacement netmap has no changes"
                      {:type :kekkai/unchanged-netmap})))
    (when-not (> new-version old-version)
      (throw (ex-info "replacement netmap version must increase"
                      {:type :kekkai/non-monotonic-netmap
                       :current old-version :received new-version})))
    (when-not (= (:netmap/tailnet current) (:netmap/tailnet nm))
      (throw (ex-info "replacement netmap changes tailnet"
                      {:type :kekkai/netmap-tailnet-changed})))
    (when-not (= (:self-id st) (:node/id self))
      (throw (ex-info "replacement netmap changes local node ID"
                      {:type :kekkai/netmap-self-changed
                       :current (:self-id st) :received (:node/id self)})))
    (when-not (= expected-key (:node/key self))
      (throw (ex-info "replacement netmap changes local node key"
                      {:type :kekkai/netmap-self-key-changed})))
    (let [old-peers (set (keys (:peers st)))
          pool (netmap/relays nm)
          base (-> st
                   (assoc :netmap nm
                          :prologue (b/utf8-encode (netmap/prologue-string nm))
                          :relay nil
                          :relay-pool pool
                          :relay-index 0
                          :peers {}
                          :by-key {}
                          :denied (netmap/denials nm :overlay
                                                 (quot now-ms* 1000)))
                   (sync-peers now-ms*))
          removed (vec (remove (set (keys (:peers base))) old-peers))
          relay-record (first pool)
          [base send] (if relay-record
                        (let [[rc dg] (relay/client-hello
                                       (relay-client-for base relay-record) now-ms*)]
                          [(assoc base :relay rc :relay-index 0) [dg]])
                        [base []])]
      {:state base
       :send send
       :events [{:event :netmap-updated
                 :from-version old-version
                 :to-version new-version
                 :reset-peers (vec old-peers)
                 :removed-peers removed}]})))

(defn- apply-netmap-text! [state-atom on-event text]
  (let [result (try
                 (let [current @state-atom
                       nm (netmap-from-text text (:config current))]
                   (if (= nm (:netmap current))
                     {:state (assoc current
                                    :netmap-source-text text
                                    :netmap-rejected-source nil
                                    :netmap-read-error nil)}
                     (let [{next-state :state sends :send events :events}
                           (reconfigure-netmap current nm (now-ms))]
                       {:state (assoc next-state
                                      :netmap-source-text text
                                      :netmap-rejected-source nil
                                      :netmap-read-error nil)
                        :send sends
                        :events events})))
                 (catch :default error {:error error}))]
    (if-let [error (:error result)]
      (do
        (swap! state-atom assoc :netmap-rejected-source text)
        (on-event {:event :netmap-rejected
                   :reason (or (ex-message error) "invalid netmap")}))
      (do
        (reset! state-atom (:state result))
        (doseq [{:keys [bytes to]} (:send result)]
          (udp/send! (:sock (:state result)) bytes to))
        (doseq [event (:events result)]
          (on-event event))))))

(defn poll-netmap!
  "Read the configured netmap path and apply a newly authenticated version.

  The producer should replace the file atomically. A transient or invalid file
  is rejected once per byte string and never replaces the last good state."
  [state-atom on-event]
  (let [st @state-atom
        path (get-in st [:config :netmap-file])]
    (when (seq path)
      (try
        (let [text (.readFileSync fs path "utf8")]
          (when-not (or (= text (:netmap-source-text @state-atom))
                        (= text (:netmap-rejected-source @state-atom)))
            (apply-netmap-text! state-atom on-event text)))
        (catch :default error
          (let [reason (or (ex-message error) "netmap file unavailable")]
            (when-not (= reason (:netmap-read-error @state-atom))
              (swap! state-atom assoc :netmap-read-error reason)
              (on-event {:event :netmap-read-error :reason reason}))))))))

(defn- failover-relay
  "Move to the next signed relay after a dead session or failed registration.
   A one-relay netmap retries that relay in place."
  [st on-event reason]
  (let [now (now-ms)
        pool (:relay-pool st)
        current (:relay st)]
    (if (> (count pool) 1)
      (let [record (relay/next-home pool (:name current))
            idx (or (first (keep-indexed
                            (fn [i r] (when (= (:relay/name r) (:relay/name record)) i))
                            pool))
                    0)
            [rc dg] (relay/client-hello (relay-client-for st record) now)]
        (udp/send! (:sock st) (:bytes dg) (:to dg))
        (on-event {:event :relay-failover :from (:name current) :to (:relay/name record)
                   :reason reason})
        (assoc st :relay rc :relay-index idx))
      (let [[rc dg] (relay/client-reconnect current now)]
        (udp/send! (:sock st) (:bytes dg) (:to dg))
        (on-event {:event :relay-reconnect :region (:region rc) :reason reason})
        (assoc st :relay rc)))))

(defn- apply-peer-out!
  [st peer-id {:keys [state send events] :as _out} on-event]
  (let [st (assoc-in st [:peers peer-id] state)
        st (reduce send-out! st send)]
    (doseq [e events] (on-event (assoc e :peer peer-id)))
    st))

(defn- handle-peer-datagram [st peer-id bytes from-endpoint on-event]
  (let [before-candidates (set (keys (get-in st [:peers peer-id :disco :paths])))
        p (get-in st [:peers peer-id])
        out (peer/on-datagram p {:bytes bytes :now-s (now-s) :now-ms (now-ms)
                                 :from-endpoint from-endpoint})
        st (apply-peer-out! st peer-id out on-event)
        st (reduce (fn [st {:keys [event tx-id endpoint candidates]}]
                     (case event
                       :ping (let [[p dg] (peer/send-pong (get-in st [:peers peer-id])
                                                          endpoint tx-id (now-s))]
                               (send-out! (assoc-in st [:peers peer-id] p) dg))
                       :call-me-maybe
                       (update-in st [:peers peer-id] peer/note-call-me-maybe
                                  (ep/exclude-candidate-hosts
                                   candidates
                                   (:candidate-excluded-hosts (:config st)))
                                  (now-ms))
                       st))
                   st
                   (:events out))
        after-candidates (set (keys (get-in st [:peers peer-id :disco :paths])))]
    ;; answer disco pings, and fold a peer's candidate list into disco
    (when (not= before-candidates after-candidates)
      ;; Packet-bridge consumers defer this notification until the state atom
      ;; commits, then refresh OS underlay exclusions before the next probe tick.
      (on-event {:event :underlay-candidates-changed :peer peer-id}))
    st))

(defn on-datagram
  "Dispatch an inbound datagram: relay frames to the relay client, peer frames to
   the peer they authenticate as. A datagram that matches nothing is dropped and
   counted — never guessed at."
  [st bytes from on-event]
  (let [relay-frame (relay/decode-frame bytes)
        peer-frame (peer/decode-frame bytes)]
    (cond
      ;; STUN shares this UDP socket with relay and peer traffic. Its response
      ;; listener consumes the message; it is not a malformed peer datagram.
      (stun/valid-message? bytes) st

      ;; from the relay socket we expect relay frames
      (and (:relay st) (= from (:relay-addr (:relay st))) (:type relay-frame))
      (let [{:keys [state send events]} (relay/client-on-datagram
                                         (:relay st) {:bytes bytes :now (now-ms)})
            st (assoc st :relay state)
            _ (doseq [{:keys [to bytes]} send] (udp/send! (:sock st) bytes to))]
        (reduce (fn [st {:keys [event src payload] :as e}]
                  (on-event e)
                  (if (and (#{:packet :signal} event) (peer-for-key st src))
                    (let [pid (get (:by-key st) src)]
                      ;; relayed: no direct endpoint to learn from
                      (handle-peer-datagram st pid payload nil on-event))
                    st))
                st events))

      ;; a direct peer frame: we do not know which peer until it decrypts, so try
      ;; the established ones first (cheap: the frame either decrypts or not)
      ;; Signed-netmap bootstrap punches are one-way NAT openers. They carry no
      ;; peer identity and must never trigger a response or authorize a session.
      (= :bootstrap-punch (:type peer-frame)) st

      (:type peer-frame)
      (let [candidates (keys (:peers st))
            endpoint (ep/parse from :reflexive)]
        (loop [ids candidates]
          (if (empty? ids)
            (do (on-event {:event :dropped :from from :reason :no-matching-peer}) st)
            (let [pid (first ids)
                  before (get-in st [:peers pid])
                  st' (handle-peer-datagram st pid bytes endpoint on-event)
                  after (get-in st' [:peers pid])]
              (if (not= before after)
                st'
                (recur (rest ids)))))))

      :else (do (on-event {:event :dropped :from from :reason :unrecognized}) st))))

;; ── tick ────────────────────────────────────────────────────────────────────

(defn tick
  [st on-event]
  (let [now-ms* (now-ms)
        now-s* (quot now-ms* 1000)
        ;; relay: connect / keepalive
        st (cond
             (nil? (:relay st)) st
             (relay/client-liveness-expired? (:relay st) now-ms*)
             (failover-relay st on-event :liveness-timeout)
             (relay/client-handshake-expired? (:relay st) now-ms*)
             (failover-relay st on-event :handshake-timeout)
             (relay/client-hello-due? (:relay st) now-ms*)
             (let [[rc dg] (relay/client-hello (:relay st) now-ms*)]
               (udp/send! (:sock st) (:bytes dg) (:to dg))
               (assoc st :relay rc))
             (relay/client-keepalive-due? (:relay st) now-ms*)
             (let [[rc dg] (relay/client-ping (:relay st) [] now-ms*)]
               (udp/send! (:sock st) (:bytes dg) (:to dg))
               (assoc st :relay rc))
             :else st)]
    (reduce (fn [st pid]
              (let [out (peer/tick (get-in st [:peers pid])
                                   {:now-s now-s* :now-ms (now-ms)
                                    :local-candidates (:local-candidates st)
                                    :bootstrap-direct? (not (and (:relay st)
                                                                 (relay/connected? (:relay st))))})]
                (apply-peer-out! st pid out on-event)))
            st
            (keys (:peers st)))))

(defn- granted-any?
  "Does the netmap grant `from` -> `to` any of `capabilities` (a keyword or a
  set of them)?"
  [nm from to capabilities]
  (let [wanted (if (keyword? capabilities) #{capabilities} (set capabilities))]
    (boolean (some wanted (netmap/capabilities nm from to)))))

(defn send-to
  "Send application bytes to an authorized peer over whatever path is active.
   -> state. Throws if the peer is unknown (not in the netmap, or not granted the
   overlay capability) or if its session is not established yet — a silent no-op
   here would look exactly like packet loss.

   `capabilities` (default `:overlay`) names which edge grant counts as
   outbound authority for this send. A funnel edge passes `#{:overlay :funnel}`,
   because the control plane publishes a funnel's grant as `[:funnel]` alone;
   every existing caller keeps the `:overlay`-only reading."
  ([st peer-id payload] (send-to st peer-id payload :overlay))
  ([st peer-id payload capabilities]
   (let [self-id (:self-id st)
         _ (when-not (granted-any? (:netmap st) self-id peer-id capabilities)
             (throw (ex-info "outbound overlay edge is not authorized"
                             {:from self-id :to peer-id})))
         p (or (get-in st [:peers peer-id])
               (throw (ex-info "no such authorized peer" {:peer peer-id
                                                          :known (vec (keys (:peers st)))})))
         [p dg] (peer/send-data p payload (now-s))]
     (send-out! (assoc-in st [:peers peer-id] p) dg))))

(defn reply-to
  "Send response bytes on an authenticated inbound overlay edge without
  creating reverse application authority. `capabilities` as in `send-to`,
  read in the inbound direction."
  ([st peer-id payload] (reply-to st peer-id payload :overlay))
  ([st peer-id payload capabilities]
   (let [self-id (:self-id st)
         _ (when-not (granted-any? (:netmap st) peer-id self-id capabilities)
             (throw (ex-info "inbound overlay edge is not authorized"
                             {:from peer-id :to self-id})))
         p (or (get-in st [:peers peer-id])
               (throw (ex-info "no authenticated inbound peer"
                               {:peer peer-id
                                :known (vec (keys (:peers st)))})))
         [p dg] (peer/send-data p payload (now-s))]
     (send-out! (assoc-in st [:peers peer-id] p) dg))))

(defn status
  [st]
  {:node (:self-id st)
   :netmap-version (:netmap/version (:netmap st))
   :relay (when (:relay st)
            {:name (:name (:relay st)) :region (:region (:relay st))
             :connected? (relay/connected? (:relay st))
             :configured-count (count (:relay-pool st))})
   :local-candidates (:local-candidates st)
   :heartbeat (:heartbeat st)
   :netmap-watch (:netmap-watch st)
   :nat (:nat st)
   :peers (mapv #(peer/summary % (now-ms)) (vals (:peers st)))
   :denied (:denied st)})

(defn- validate-local-identity! [config nm]
  (let [self (:netmap/self nm)
        configured-id (:node/id config)
        configured-key (some-> (:pub (:static config)) b/unhex b/hex)]
    (when (and configured-id (not= configured-id (:node/id self)))
      (throw (ex-info "configured node ID does not match the signed netmap"
                      {:type :kekkai/netmap-self-mismatch})))
    (when-not (= configured-key (:node/key self))
      (throw (ex-info "configured static key does not match the signed netmap"
                      {:type :kekkai/netmap-self-key-mismatch}))))
  nm)

;; ── process ─────────────────────────────────────────────────────────────────

(defn- start-agent!
  "-> Promise of `{:state-atom :stop :status}`.

   `config`:
     :node/id     this node's id (must match the netmap's :netmap/self)
     :static      {:priv hex :pub hex} — this node's X25519 identity
     :netmap-file path to the netmap EDN
     :netmap-poll-ms interval for signed netmap updates (default 1000)
     :listen-host UDP bind address (default ::, dual-stack IPv4/IPv6; 0.0.0.0
                  also selects the dual-stack wildcard)
     :listen-port UDP port for the overlay (0 = ephemeral)
     :stun-servers [\"host:port\" …] for reflexive candidates
     :candidate-excluded-hosts [\"IP\" …] exact IPs omitted from local and
                                  peer candidate discovery
     :heartbeat {:url https://… :did … :seed-file … :sequence-file …}
                  optional enrolled Ed25519 identity for candidate publication
     :dns         {:enabled? true :port 5354}
     :tick-ms     default 1000"
  [{:keys [config on-event] :or {on-event log-event}}]
  (let [source-text (.readFileSync fs (:netmap-file config) "utf8")
        nm (validate-local-identity! config (netmap-from-text source-text config))
        problems (netmap/validate nm)]
    (when (seq problems)
      (throw (ex-info "netmap is not usable" {:problems problems})))
    (let [config (assoc config :netmap-source-text source-text)
          heartbeat-config (:heartbeat config)
          heartbeat-identity (when heartbeat-config
                               (node-heartbeat/load-identity! heartbeat-config))
          self-id (or (:node/id (:netmap/self nm)) (:node/id config))
          _ (when (and heartbeat-config
                       (not= (:did heartbeat-config) (:did heartbeat-identity)))
              (throw (ex-info "heartbeat DID does not match the node's enrolled identity"
                              {:type :kekkai/heartbeat-did-mismatch})))
          heartbeat-interval-ms (or (:interval-ms heartbeat-config) 30000)
          _ (when (and heartbeat-config
                       (not (<= 1000 heartbeat-interval-ms 3600000)))
              (throw (ex-info "heartbeat interval must be in 1000..3600000 ms"
                              {:type :kekkai/invalid-heartbeat-interval})))
          st (atom (state {:config config :nm nm}))
          tick-ms (or (:tick-ms config) 1000)
          netmap-poll-ms (or (:netmap-poll-ms config) 1000)
          last-heartbeat-endpoints (atom nil)
          last-heartbeat-at (atom 0)
          heartbeat-in-flight? (atom false)
          publish-heartbeat!
          (fn [force?]
            (when (and heartbeat-config
                       (not @heartbeat-in-flight?)
                       (not= :pending (get-in @st [:nat :status])))
              (try
                (let [candidates (:local-candidates @st)
                      endpoints (node-heartbeat/candidate-strings candidates)
                      now (now-ms)
                      changed? (not= endpoints @last-heartbeat-endpoints)
                      due? (>= (- now @last-heartbeat-at) heartbeat-interval-ms)]
                  (when (or changed? force? due?)
                    (reset! heartbeat-in-flight? true)
                    (-> (node-heartbeat/post!
                         (assoc heartbeat-config
                                :node-id self-id
                                :seed (:seed heartbeat-identity))
                         candidates)
                        (.then (fn [{:keys [sequence]}]
                                 (reset! last-heartbeat-endpoints endpoints)
                                 (reset! last-heartbeat-at (now-ms))
                                 (swap! st assoc :heartbeat
                                        {:enabled? true :sequence sequence
                                         :last-accepted-at (now-s) :last-error nil})
                                 (on-event {:event :heartbeat-accepted
                                            :node self-id :sequence sequence})
                                 (reset! heartbeat-in-flight? false)))
                        (.catch (fn [error]
                                  (reset! heartbeat-in-flight? false)
                                  (let [status (some-> error ex-data :status)
                                        reason (or status (ex-message error))]
                                    (swap! st assoc :heartbeat
                                           {:enabled? true
                                            :sequence (:sequence (:heartbeat @st))
                                            :last-accepted-at (:last-accepted-at
                                                               (:heartbeat @st))
                                            :last-error reason})
                                    (on-event {:event :heartbeat-error :node self-id
                                               :status status :reason reason})))))))
                (catch :default error
                  (reset! heartbeat-in-flight? false)
                  (let [reason (or (some-> error ex-data :type) :invalid-candidates)]
                    (swap! st assoc-in [:heartbeat :last-error] reason)
                    (on-event {:event :heartbeat-error :node self-id
                               :reason reason}))))))]
      (-> (udp/socket
           {:port (or (:listen-port config) 0)
            :host (:listen-host config)
            ;; A datagram handler that throws must neither crash the process nor
            ;; silently swallow the packet: an exception here previously lost a
            ;; relay handshake response with no trace of why (found in the E2E).
            :on-message (fn [bytes from]
                          ;; A datagram may already be queued when the caller
                          ;; stops this agent. In particular, a peer can send a
                          ;; final ping while `kekkai ssh` is tearing down its
                          ;; temporary socket. Do not answer after stop has
                          ;; begun: the UDP socket is closed below, and sending
                          ;; on it raises ERR_SOCKET_DGRAM_NOT_RUNNING.
                          (when-not (:stopping? @st)
                            (try
                              (swap! st on-datagram bytes from on-event)
                              (catch :default e
                                (on-event {:event :handler-error :from from
                                           :reason (ex-message e)
                                           :stack (some-> e .-stack)})))))})
          (.then
           (fn [sock]
             (swap! st assoc :sock sock)
             (swap! st assoc :local-candidates
                    (ep/exclude-candidate-hosts
                     (udp/local-candidates (udp/local-port sock))
                     (:candidate-excluded-hosts config)))
             ;; connect to the first relay in the signed publication order
             (when-let [r (first (:relay-pool @st))]
               (let [[rc dg] (relay/client-hello (relay-client-for @st r) (now-ms))]
                 (swap! st assoc :relay rc :relay-index 0)
                 (udp/send! sock (:bytes dg) (:to dg))))
             (swap! st sync-peers (now-ms))
             (on-event {:event :started :node (:self-id @st)
                        :port (udp/local-port sock)
                        :peers (vec (keys (:peers @st)))
                        :denied (:denied @st)})
             ;; reflexive candidates on the *same* socket the data plane uses
             (when (seq (:stun-servers config))
               (-> (stun/candidates {:servers (:stun-servers config)
                                     :sock sock
                                     :timeout-ms (or (:stun-timeout-ms config) 5000)})
                   (.then (fn [{:keys [candidates servers-answered symmetric?] :as nat}]
                            (let [candidates (ep/exclude-candidate-hosts
                                              candidates
                                              (:candidate-excluded-hosts config))]
                              (swap! st update :local-candidates into candidates)
                              (swap! st assoc :nat (assoc nat :candidates candidates
                                                          :status :complete))
                              (on-event {:event :reflexive :candidates candidates
                                       :servers-answered servers-answered
                                       :symmetric-nat? symmetric?})
                              (publish-heartbeat! true))))
                   (.catch (fn [error]
                             (swap! st assoc :nat
                                    {:status :error :servers-answered 0
                                     :candidates [] :symmetric? nil})
                             (on-event {:event :reflexive-error
                                        :reason (ex-message error)})
                             (publish-heartbeat! true)))))
             (when-not (seq (:stun-servers config))
               (publish-heartbeat! true))
             (let [timer (js/setInterval #(swap! st tick on-event) tick-ms)
                   netmap-timer (js/setInterval #(poll-netmap! st on-event)
                                                 netmap-poll-ms)
                   heartbeat-timer (when heartbeat-config
                                     (js/setInterval #(publish-heartbeat! false)
                                                     heartbeat-interval-ms))
                   base {:state st
                         :status #(status @st)
                         :stop (fn []
                                 (when-not (:stopping? @st)
                                   (swap! st assoc :stopping? true)
                                   (js/clearInterval timer)
                                   (js/clearInterval netmap-timer)
                                   (when heartbeat-timer
                                     (js/clearInterval heartbeat-timer))
                                   (udp/close! sock)
                                   (on-event {:event :stopped})))}]
               (if-not (get-in config [:dns :enabled?])
                 base
                 ;; await the DNS listener so the caller gets its actual port —
                 ;; it may be ephemeral, and a caller that has to scrape the log
                 ;; for it would be relying on log formatting
                 (-> (dns-server/start {:port (get-in config [:dns :port])
                                        :netmap-fn #(:netmap @st)
                                        :tailnet (:netmap/tailnet nm)
                                        :on-event on-event})
                     (.then (fn [d]
                              (assoc base
                                     :dns-port (udp/local-port (:sock d))
                                     :stop (fn [] ((:stop base)) ((:stop d)))))))))))))))

(defn- configured-netmap-watch [config]
  (when-let [watch (:netmap-watch config)]
    (when-not (map? watch)
      (throw (ex-info ":netmap-watch must be a map"
                      {:type :kekkai/invalid-netmap-watch-config})))
    (let [heartbeat-config (:heartbeat config)
          read-identity (or (:heartbeat watch)
                            (select-keys heartbeat-config [:did :seed-file]))
          watch-config (assoc watch
                              :node-id (or (:node-id watch) (:node/id config))
                              :node-static-key (some-> (:pub (:static config))
                                                       b/unhex b/hex)
                              :authority-spki-b64 (:netmap-authority-spki-b64 config)
                              :output-file (:netmap-file config)
                              :heartbeat read-identity)]
      (netmap-watch/validate-config! watch-config))))

(defn- bootstrapped-netmap! [config watch-config]
  (if (or (nil? watch-config)
          (.existsSync fs (:netmap-file config)))
    (js/Promise.resolve :cached)
    (-> (js/Promise.resolve)
        (.then (fn [_] (netmap-watch/install-current! watch-config)))
        (.then (fn [result]
                 (when (= :unavailable (:status result))
                   (throw (ex-info "no signed bootstrap netmap is published for this node"
                                   {:type :kekkai/netmap-bootstrap-unavailable
                                    :subject (:subject watch-config)})))
                 result)))))

(defn- attach-netmap-watch [handle watch-config on-event]
  (if-not watch-config
    handle
    (let [state-atom (:state handle)
          watcher (netmap-watch/start!
                   watch-config
                   (fn [event]
                     (case (:event event)
                       :netmap-watch-result
                       (swap! state-atom update :netmap-watch merge
                              {:enabled? true
                               :status (:status event)
                               :last-installed-version (:netmap/version event)
                               :last-error nil})

                       :netmap-watch-error
                       (swap! state-atom update :netmap-watch merge
                              {:enabled? true :status :error
                               :last-error (:reason event)})
                       nil)
                     (on-event event)))]
      (on-event {:event :netmap-watch-started
                 :subject (:subject watch-config)
                 :poll-ms (or (:poll-ms watch-config) 5000)})
      (assoc handle :stop
             (fn []
               ((:stop watcher))
               ((:stop handle)))))))

(defn start
  "Start the resident agent and optionally keep its signed netmap fresh.

  With `:netmap-watch`, a missing cache is fetched and verified before the UDP
  identity starts. An existing signed cache starts immediately while the
  cancellable watcher refreshes it in the background."
  [{:keys [config on-event] :or {on-event log-event}}]
  (let [watch-config (configured-netmap-watch config)
        args {:config config :on-event on-event}]
    (-> (bootstrapped-netmap! config watch-config)
        (.then (fn [_] (start-agent! args)))
        (.then #(attach-netmap-watch % watch-config on-event)))))

(defn -main [& args]
  (let [path (or (first args) "kekkai-node.edn")
        config (cljs.reader/read-string (.readFileSync fs path "utf8"))]
    (-> (start {:config config})
        (.then (fn [{:keys [status]}]
                 (js/setInterval #(println (str "[status] " (pr-str (status)))) 30000)))
        (.catch (fn [e] (js/console.error (str "agent failed: " (ex-message e)))
                  (set! (.-exitCode js/process) 1))))))
