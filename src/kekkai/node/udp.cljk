(ns kekkai.node.udp
  "The one place this repo touches a socket. Everything above it is pure `.cljc`,
  so this file stays boring on purpose: bind, send, receive, close, and the
  Buffer↔byte-vector conversion.

  Byte-vectors (not Buffers) cross the boundary because that is what the protocol
  cores speak on both runtimes; the copy costs a few microseconds per datagram
  and buys one implementation of the protocol instead of two."
  (:require [kotoba.lang.text :as str]
            ["node:dgram" :as dgram]
            ["node:os" :as os]
            ["node:net" :as net]
            ["node:dns/promises" :as dns]))

(def ^:private underlay-guards (js/WeakMap.))

(defn ->vec [buf] (vec (js/Uint8Array.from buf)))
(defn ->buf [bytes] (js/Buffer.from (js/Uint8Array.from (clj->js (vec bytes)))))

(declare parse-addr resolve-host-addresses)

(defn- socket-host [host]
  ;; A dual-stack udp6 socket accepts IPv4 destinations in mapped form. Node's
  ;; send() rejects a plain IPv4 literal when the socket family is udp6.
  (if (= 4 (.isIP net host)) (str "::ffff:" host) host))

(defn- normalize-mapped-v4 [host]
  (when (str/starts-with? (str/lower host) "::ffff:")
    (let [tail (subs host 7)]
      (if (str/includes? tail ".")
        tail
        (let [parts (str/split tail #":")]
          (when (= 2 (count parts))
            (let [hi (js/parseInt (nth parts 0) 16)
                  lo (js/parseInt (nth parts 1) 16)]
              (str (bit-shift-right hi 8) "." (bit-and hi 255) "."
                   (bit-shift-right lo 8) "." (bit-and lo 255)))))))))

(defn- send-addresses! [sock buffer port addresses]
  (letfn [(attempt [remaining last-error]
            (if-let [address (first remaining)]
              (try
                (.send sock buffer port (socket-host address)
                       (fn [error]
                         (when error
                           (attempt (rest remaining) error))))
                (catch :default error
                  (attempt (rest remaining) error)))
              (when last-error
                (.emit sock "error" last-error))))]
    (attempt (seq addresses) nil)))

(defn- send-addresses-all! [sock buffer port addresses]
  (when (seq addresses)
    (let [remaining (atom (count addresses))
          succeeded (atom false)
          errors (atom [])
          finish (fn [error]
                   (if error
                     (swap! errors conj error)
                     (reset! succeeded true))
                   (when (zero? (swap! remaining dec))
                     (when (and (not @succeeded) (seq @errors))
                       (.emit sock "error" (last @errors)))))]
      (doseq [address addresses]
        (try
          (.send sock buffer port (socket-host address) finish)
          (catch :default error
            (finish error)))))))

(defn- send-now! [sock bytes addr guard]
  (let [[host port] (parse-addr addr)
        addresses (or (seq (get @(:resolved guard) host)) [host])]
    (send-addresses! sock (->buf bytes) port addresses)))

(defn- queue-pending! [guard bytes addr]
  (when (< (count @(:pending guard)) 4096)
    (swap! (:pending guard) conj {:bytes (vec bytes) :addr addr})))

(defn- queue-pending-family! [guard bytes addr family]
  (when (< (count @(:pending guard)) 4096)
    (swap! (:pending guard) conj {:bytes (vec bytes) :addr addr :family family})))

(defn- send-resolved! [sock bytes addr host port]
  (let [buffer (->buf bytes)]
    (if (pos? (.isIP net host))
      (send-addresses! sock buffer port [host])
      (-> (.lookup dns host #js {:all true :verbatim true})
          (.then (fn [records]
                   (let [addresses (vec (distinct (map #(.-address %)
                                                       (array-seq records))))]
                     (when-not (seq addresses)
                       (throw (js/Error. (str "no IP addresses for UDP host " host))))
                     (if-let [guard (.get underlay-guards sock)]
                       (if (contains? @(:allowed guard) host)
                         (send-addresses! sock buffer port
                                          (or (seq (get @(:resolved guard) host))
                                              addresses))
                         (queue-pending! guard bytes addr))
                       (send-addresses! sock buffer port addresses)))))
          (.catch (fn [error]
                    ;; Match dgram's own asynchronous send failures: surface them
                    ;; on the socket error channel rather than inventing a result.
                    (.emit sock "error" error)))))))

(defn addr->str [rinfo]
  (let [raw (.-address rinfo)
        host (or (normalize-mapped-v4 raw) raw)]
    (if (= 6 (.isIP net host))
      (str "[" host "]:" (.-port rinfo))
      (str host ":" (.-port rinfo)))))

(defn parse-addr
  "\"host:port\" -> [host port]; IPv6 in brackets."
  [s]
  (if (str/starts-with? s "[")
    (let [close (str/index-of s "]")]
      [(subs s 1 close) (js/parseInt (subs s (+ close 2)))])
    (let [idx (str/last-index-of s ":")]
      [(subs s 0 idx) (js/parseInt (subs s (inc idx)))])))

(defn resolve-host-addresses
  "Resolve an IP literal or hostname to distinct IPv4 and IPv6 addresses."
  [host]
  (if (pos? (.isIP net host))
    (js/Promise.resolve [host])
    (-> (.lookup dns host #js {:all true :verbatim true})
        (.then (fn [records]
                 (let [addresses (vec (distinct (map #(.-address %)
                                                     (array-seq records))))]
                   (when-not (seq addresses)
                     (throw (js/Error. (str "no IP addresses for UDP host " host))))
                   addresses))))))

(def ^:private ipv6-bind-unavailable-codes
  #{"EAFNOSUPPORT" "EPROTONOSUPPORT" "EADDRNOTAVAIL"})

(defn- ipv4-fallback-host [host]
  (cond
    (nil? host) "0.0.0.0"
    (contains? #{"::" "0.0.0.0"} host) "0.0.0.0"
    (= 4 (.isIP net host)) host
    :else nil))

(defn- create-socket [socket-api type]
  (let [options (if (= type "udp6")
                  #js {:type "udp6" :ipv6Only false}
                  #js {:type "udp4"})]
    (if socket-api
      (.createSocket socket-api options)
      (.createSocket dgram options))))

(defn socket
  "Create a dual-stack UDP socket when IPv6 is available, falling back to an
   IPv4 socket on hosts where the IPv6 address family cannot bind. `on-message`
   gets [byte-vector from-addr-string]. Returns a promise of the socket."
  [{:keys [port host on-message on-error socket-api]}]
  (js/Promise.
   (fn [resolve reject]
     (let [fallback-host (ipv4-fallback-host host)
           bind-host (cond
                       (nil? host) "::"
                       (= host "0.0.0.0") "::"
                       (= 4 (.isIP net host)) (socket-host host)
                       :else host)]
       (letfn [(bind! [type address fallback?]
                 (let [sock (create-socket socket-api type)
                       settled? (atom false)]
                   (.on sock "message" (fn [msg rinfo]
                                         (when on-message
                                           (on-message (->vec msg)
                                                       (addr->str rinfo)))))
                   (.on sock "error"
                        (fn [err]
                          (if (and fallback?
                                   fallback-host
                                   (contains? ipv6-bind-unavailable-codes
                                              (.-code err))
                                   (not @settled?))
                            (do
                              (reset! settled? true)
                              (.removeAllListeners sock)
                              (try (.close sock) (catch :default _ nil))
                              (bind! "udp4" fallback-host false))
                            (do
                              (if on-error
                                (on-error err)
                                (js/console.error err))
                              (when-not @settled?
                                (reset! settled? true)
                                (reject err))))))
                   (.bind sock (or port 0) address
                          (fn []
                            (when-not @settled?
                              (reset! settled? true)
                              (resolve sock))))))]
         (bind! "udp6" bind-host true))))))

(defn send!
  "Fire and forget — UDP. Failures surface on the socket's error handler, which is
   the same place the OS reports them; there is no per-datagram delivery promise
   to await and pretending otherwise would be a lie in the type."
  [sock bytes addr]
  (let [[host port] (parse-addr addr)
        guard (.get underlay-guards sock)]
    (if (and guard (not (contains? @(:allowed guard) host)))
      (queue-pending! guard bytes addr)
      (if guard
        (send-now! sock bytes addr guard)
        (send-resolved! sock bytes addr host port)))))

(defn send-family!
  "Send one UDP datagram to every resolved address for the requested IP family.
   The original hostname remains the underlay-guard key so tunnel route
   acknowledgements still gate DNS-derived destinations."
  [sock bytes addr family]
  (let [[host port] (parse-addr addr)
        guard (.get underlay-guards sock)]
    (if guard
      (if (contains? @(:allowed guard) host)
        (let [addresses (or (seq (get @(:resolved guard) host)) [host])
              selected (filterv #(= family (.isIP net %)) addresses)]
          (send-addresses-all! sock (->buf bytes) port selected))
        (queue-pending-family! guard bytes addr family))
      (-> (resolve-host-addresses host)
          (.then (fn [addresses]
                   ;; The packet tunnel may install its route guard while DNS
                   ;; is pending. Recheck after resolution before sending any
                   ;; physical-underlay packet.
                   (if-let [current-guard (.get underlay-guards sock)]
                     (if (contains? @(:allowed current-guard) host)
                       (let [resolved (or (seq (get @(:resolved current-guard) host))
                                          addresses)]
                         (send-addresses-all!
                          sock (->buf bytes) port
                          (filterv #(= family (.isIP net %)) resolved)))
                       (queue-pending-family! current-guard bytes addr family))
                     (send-addresses-all!
                      sock (->buf bytes) port
                      (filterv #(= family (.isIP net %)) addresses)))))
          (.catch (fn [error]
                    (.emit sock "error" error)))))))

(defn guard-underlay!
  "Queue outbound datagrams until their destination host is covered by an OS
  underlay exclusion acknowledged by the packet-tunnel provider. The queue is
  bounded because this is a route-safety gate, not a retry store."
  [sock]
  (let [guard {:allowed (atom #{}) :resolved (atom {}) :pending (atom [])}]
    (.set underlay-guards sock guard)
    guard))

(defn clear-underlay-guard!
  "Release a previously installed provider guard after the OS removed its
  tunnel routes. Pending datagrams are discarded; regular protocol timers retry."
  [sock]
  (when-let [guard (.get underlay-guards sock)]
    (.delete underlay-guards sock)
    (reset! (:pending guard) [])))

(defn allow-underlay-hosts!
  "Mark hosts whose resolved addresses have been installed as excluded routes,
  then release their queued datagrams in original order."
  [sock hosts resolved]
  (when-let [guard (.get underlay-guards sock)]
    (let [allowed (set hosts)
          pending @(:pending guard)
          ready (filter #(contains? allowed (first (parse-addr (:addr %))))
                        pending)
          blocked (remove #(contains? allowed (first (parse-addr (:addr %))))
                          pending)]
      (reset! (:allowed guard) allowed)
      (reset! (:resolved guard) resolved)
      (reset! (:pending guard) (vec blocked))
      (doseq [{:keys [bytes addr family]} ready]
        (if family
          (let [[host port] (parse-addr addr)
                addresses (or (seq (get @(:resolved guard) host)) [host])
                selected (filterv #(= family (.isIP net %)) addresses)]
            (send-addresses-all! sock (->buf bytes) port selected))
          (send-now! sock bytes addr guard))))))

(defn local-port [sock] (.-port (.address sock)))

(defn close! [sock] (.close sock))

(defn local-candidates
  "Non-loopback IPv4 and usable IPv6 addresses of this host, formatted as
   `host:port` or `[ipv6]:port`. These are local candidates — worthless across
   the internet, decisive on the same LAN."
  [port & {:keys [include-loopback?]}]
  (let [ifaces (js->clj (.networkInterfaces os) :keywordize-keys true)]
    (->> (for [[_ addrs] ifaces
               a addrs
               :let [address (:address a)
                     family (:family a)
                     ipv6? (= "IPv6" family)
                     lower (str/lower address)
                     usable-v6? (and ipv6?
                                     (not= lower "::")
                                     (or include-loopback? (not= lower "::1"))
                                     (not (str/starts-with? lower "fe80:"))
                                     (not (str/starts-with? lower "ff")))
                     usable-v4? (and (= "IPv4" family)
                                     (or include-loopback? (not (:internal a))))]
               :when (or usable-v4? usable-v6?)]
           (if ipv6?
             (str "[" address "]:" port)
             (str address ":" port)))
         distinct
         vec)))
